# Copy to .env and fill in. .env is git-ignored; this file is not, so keep real
# secrets out of it.

# --- Database ---------------------------------------------------------------
# Host-facing URL for the Prisma CLI; docker-compose.yml overrides it inside the
# web container. Keep the POSTGRES_* values in sync with it.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/ticketing_support?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ticketing_support"

# --- Auth -------------------------------------------------------------------
# A long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=""

# The admin account the seed creates. Change the password before the first run.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Administrator"

# --- URLs -------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT="3001"

# --- Mailpit (development only) ---------------------------------------------
# Starts Mailpit with docker-compose.dev.yml and sends all mail to its inbox at
# http://localhost:8025 instead of through the settings below. Remove it or leave
# it empty to use those settings. Production ignores it.
COMPOSE_PROFILES="mailpit"

# --- Email (any SMTP provider) ---------------------------------------------
# Required in production: new users get their sign-in details by email. Without
# SMTP_HOST, development prints each email to the server log instead.
SMTP_HOST=""
SMTP_PORT="587"
# true = implicit TLS (port 465). On 587 the connection is upgraded with STARTTLS.
SMTP_SECURE=""
# true = refuse to send unless STARTTLS succeeds (recommended on 587).
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
# Use a sender on a domain you control, with SPF and DKIM set up at your provider.
MAIL_FROM="Support Portal <no-reply@example.com>"
MAIL_REPLY_TO=""
# false = stop mirroring in-app notifications by email (account emails still go).
MAIL_NOTIFICATIONS="true"
# Optional tuning.
# SMTP_POOL_MAX="3"
# MAIL_RETRY_ATTEMPTS="3"
# MAIL_DEBUG="false"
# Only for an internal relay with a self-signed certificate:
# SMTP_TLS_REJECT_UNAUTHORIZED="false"

# OAuth2 instead of a password (e.g. Microsoft 365):
# SMTP_AUTH="oauth2"
# SMTP_OAUTH_CLIENT_ID=""
# SMTP_OAUTH_CLIENT_SECRET=""
# SMTP_OAUTH_REFRESH_TOKEN=""
# SMTP_OAUTH_TOKEN_URL=""

# --- Provider presets (copy one block over the values above) ---------------
#
# Gmail / Google Workspace
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  SMTP_SECURE="true"
#   SMTP_USER = the full mailbox address
#   SMTP_PASSWORD = an App Password (needs 2-Step Verification on the account)
#   MAIL_FROM must be that mailbox or one of its configured aliases.
#   Daily sending caps apply (about 500 for Gmail, 2,000 for Workspace).
#
# Microsoft 365 / Outlook
#   SMTP_HOST="smtp.office365.com"  SMTP_PORT="587"  SMTP_REQUIRE_TLS="true"
#   SMTP_USER = the mailbox address; SMTP AUTH must be enabled for it.
#   Password sign-in for SMTP is being retired: prefer SMTP_AUTH="oauth2" with an
#   Entra app registration (token URL
#   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token), or an
#   Exchange connector that relays from your server's IP.
#
# Amazon SES
#   SMTP_HOST="email-smtp.<region>.amazonaws.com"  SMTP_PORT="587"
#   SMTP_REQUIRE_TLS="true"
#   SMTP_USER / SMTP_PASSWORD = SES SMTP credentials (not the IAM access key).
#   MAIL_FROM must be a verified identity; leave the SES sandbox before mailing
#   real users.
#
# Brevo
#   SMTP_HOST="smtp-relay.brevo.com"  SMTP_PORT="587"  SMTP_REQUIRE_TLS="true"
#   SMTP_USER = the SMTP login shown in Brevo; SMTP_PASSWORD = the SMTP key.
#   MAIL_FROM must be a verified sender.
